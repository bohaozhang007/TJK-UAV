<launch>
  <arg name="config"/>
  <arg name="robot" default="owl_ego"/>
  <arg name="bridge_name" default="owl_ego_v22_bridge"/>
  <!-- Uses only the v22 Robot configuration and namespace. -->
  <node pkg="owl_nav_v22" type="owl_nav_v22_node.py" name="$(arg bridge_name)" output="screen" required="true">
    <param name="config" value="$(arg config)"/>
    <param name="robot" value="$(arg robot)"/>
  </node>
</launch>
